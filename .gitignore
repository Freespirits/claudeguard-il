# dependencies
node_modules/

# real authorization scope files carry ownership/authorization attestations — never commit
claudeguard.scope.yml

# build artifact — regenerate with: node scripts/build.mjs
claudeguard-skill.zip

# noise
*.log
.DS_Store
Thumbs.db

# local secrets — a security tool must NEVER commit its own .env. Note this does NOT match
# .env.example / .env.template / .env.sample (different names, meant to be committed).
.env
.env.local
.env.*.local
# …except the fake test fixture, which is committed on purpose:
!sample-vulnerable-app/.env

# Claude Code agent worktrees and session scratch � never commit
.claude/
