<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!-- The launcher activity. Exported because the platform requires it to be. -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not for other apps. Nothing outside the app can reach it. -->
        <provider
            android:name=".OrdersProvider"
            android:authorities="com.example.delivery.orders"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Still exported, but behind a signature-level permission: only a build signed with the
             same key can hold it, so no third-party app can invoke this. -->
        <service
            android:name=".SyncService"
            android:exported="true"
            android:permission="com.example.delivery.SYNC" />
    </application>

    <permission
        android:name="com.example.delivery.SYNC"
        android:protectionLevel="signature" />
</manifest>
