{
  "name": "chord-mini-app",
  "version": "0.6.5",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "./src/styles/**/*",
    "./src/app/globals.css"
  ],
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:e2e": "playwright test --config __tests__/playwright.config.ts",
    "test:e2e:ui": "playwright test --config __tests__/playwright.config.ts --ui",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify:firebase-cors": "node scripts/verify-firebase-audio-cors.mjs",
    "export-cookies": "node scripts/export-cookies.js",
    "backfill:transcriptions:homepage": "node scripts/backfill-transcription-homepage-metadata.js",
    "backfill:transcriptions:usage": "node scripts/backfill-transcription-usage-count.js",
    "firebase:indexes:deploy": "firebase deploy --only firestore:indexes --project chordmini-d29f9",
    "analyze": "ANALYZE=true npm run build",
    "analyze:server": "BUNDLE_ANALYZE=server npm run build",
    "analyze:browser": "BUNDLE_ANALYZE=browser npm run build"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^13.8.0",
    "next": "^16.2.12",
    "react": "^19.0.0"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "brace-expansion": "5.0.8",
    "google-gax": "5.0.6",
    "http-proxy-agent": "9.0.0",
    "js-yaml": "^4.2.0",
    "postcss": "$postcss",
    "retry-request": "8.0.2",
    "teeny-request": "10.1.2",
    "test-exclude": {
      "minimatch": "3.1.5"
    },
    "uuid": "14.0.0",
    "sharp": "$sharp"
  }
}
