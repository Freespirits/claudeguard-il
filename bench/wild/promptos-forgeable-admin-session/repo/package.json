{
  "name": "promptos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "generate-docs": "tsx scripts/generate-api-docs.ts",
    "worker:aggregation": "tsx --tsconfig tsconfig.worker.json workers/aggregationWorker.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.8",
    "@google/generative-ai": "^0.24.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.49.4",
    "ai": "^7.0.56",
    "next": "15.5.21",
    "openai": "^5.19.1",
    "react": "^19.0.0",
    "zod": "^3.25.76"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
